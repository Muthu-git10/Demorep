@Library('DevOpsShared@v1') _
pipeline {
    agent any
    parameters {
        string(name: 'releaseUnitBuild', description: 'REQUIRED: Build Number of the release unit you wish to deploy')
    }
    environment {
        def ASSET_ID = "1821"
        def ASSET_NAME = "IN-Cases"
        def ASSET_AREA_NAME = "ECSSG"
        def TARGET_ACCOUNT = "107354778857" // Defaulting to the specified AWS account
        def TEMPLATE_NAME = 'ECSSG'
        def ASSET_GROUP = "cert"
        def RELEASE_UNIT = [commons.getBranchName(), params.releaseUnitBuild].join('/')
    }
    stages {
        stage('Stage Release Unit') {
            steps {
                stageReleaseUnit()
            }
        }
        stage('Create Change Set') {
            steps {
                cloudformation(
                        command: 'createChangeSet',
                        account: TARGET_ACCOUNT,
                        region: 'us-east-1',
                        templateName: TEMPLATE_NAME,
                        stackParameters: [
                                'AssetGroup'        : ASSET_GROUP,
                                'AssetName'         : ASSET_NAME,
                                'AssetID'           : ASSET_ID,
                        ]
                )
            }
        }
        stage('Execute Change Set') {
            steps {
                cloudformation(
                        command: 'executeChangeSet',
                        account: TARGET_ACCOUNT,
                        region: 'us-east-1',
                        templateName: TEMPLATE_NAME
                )
            }
        }
    }
}